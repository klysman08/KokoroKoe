{
  "specifications": [
    {
      "id": "kokorokoe.insight.recent",
      "version": 2,
      "purpose": "insight",
      "variables": [
        "project",
        "session",
        "preset",
        "requestedInsightTypes",
        "transcriptSegments"
      ],
      "approximateRequestTokenLimit": 8192,
      "maximumOutputTokens": 1024,
      "outputSchemaId": "insight_batch_v2",
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["insights"],
        "properties": {
          "insights": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "title",
                "content",
                "rationale",
                "relatedSegmentIds",
                "confidence"
              ],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "suggested_response",
                    "follow_up_question",
                    "clarification",
                    "fact_or_number",
                    "risk",
                    "objection",
                    "decision",
                    "action_item",
                    "contradiction",
                    "unaddressed_topic"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "content": {
                  "type": "string"
                },
                "rationale": {
                  "type": ["string", "null"]
                },
                "relatedSegmentIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": ["number", "null"]
                }
              }
            }
          }
        }
      },
      "fallbackStrategy": "single_json_repair_then_fail"
    },
    {
      "id": "kokorokoe.summary.session",
      "version": 2,
      "purpose": "summary",
      "variables": [
        "project",
        "session",
        "preset",
        "summaryKind",
        "transcriptSegments"
      ],
      "approximateRequestTokenLimit": 32768,
      "maximumOutputTokens": 4096,
      "outputSchemaId": "session_summary_v2",
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "executiveSummary",
          "mainTopics",
          "decisions",
          "actionItems",
          "risks",
          "openQuestions",
          "nextSteps"
        ],
        "properties": {
          "executiveSummary": {
            "type": "string"
          },
          "mainTopics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "decisions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "actionItems": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["text", "owner", "deadline", "relatedSegmentIds"],
              "properties": {
                "text": {
                  "type": "string"
                },
                "owner": {
                  "type": ["string", "null"]
                },
                "deadline": {
                  "type": ["string", "null"]
                },
                "relatedSegmentIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "risks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "openQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextSteps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "fallbackStrategy": "single_json_repair_then_fail"
    },
    {
      "id": "kokorokoe.manual_question.segment",
      "version": 2,
      "purpose": "manual_question",
      "variables": [
        "project",
        "session",
        "preset",
        "question",
        "selectedSegmentId",
        "transcriptSegments"
      ],
      "approximateRequestTokenLimit": 8192,
      "maximumOutputTokens": 2048,
      "outputSchemaId": "manual_answer_v2",
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["answer", "relatedSegmentIds", "limitations"],
        "properties": {
          "answer": {
            "type": "string"
          },
          "relatedSegmentIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "fallbackStrategy": "single_json_repair_then_fail"
    }
  ]
}
