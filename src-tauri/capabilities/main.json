{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege settings and bounded audio-prototype capability for the KokoroKoe main window.",
  "windows": ["main"],
  "permissions": [
    "allow-get-settings",
    "allow-update-settings",
    "allow-choose-workspace",
    "allow-list-audio-devices",
    "allow-start-audio-capture-prototype",
    "allow-get-audio-capture-prototype-status",
    "allow-stop-audio-capture-prototype"
  ]
}
